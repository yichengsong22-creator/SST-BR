   "source": [
    "# SST-BR Interactive Demo\n",
    "\n",
    "**Spatial–Spectral–Temporal Baseline–Residual Learning for mmWave Radar Heart-Rate Estimation**\n",
    "\n",
    "Pre-publication executable demonstration"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6b695ab6",
   "metadata": {},
   "source": [
    "## Method overview\n",
    "\n",
    "`local window Δt → spatial–spectral representation`  \n",
    "`multiple local representations over T → temporal fusion → baseline`  \n",
    "`current local representation → residual`  \n",
    "`baseline + residual → HR`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1786db4d",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-18T07:15:19.530705Z",
     "iopub.status.busy": "2026-09-18T07:15:19.530155Z",
     "iopub.status.idle": "2026-09-18T07:15:20.434637Z",
     "shell.execute_reply": "2026-09-18T07:15:20.433084Z"
    }
   },
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from sstbr.demo.synthetic import generate_synthetic_recording\n",
    "\n",
    "recording = generate_synthetic_recording()\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 3.2))\n",
    "axes[0].imshow(np.abs(recording.radar_windows[0]), aspect=\"auto\", origin=\"lower\", cmap=\"Blues\")\n",
    "axes[0].set(title=\"Synthetic radar magnitude\", xlabel=\"Slow-time sample\", ylabel=\"Range bin\")\n",
    "t_ppg = np.arange(len(recording.ppg)) / recording.ppg_hz\n",
    "axes[1].plot(t_ppg, recording.ppg, color=\"#d95f3d\", lw=1.2)\n",
    "axes[1].set(title=\"Synthetic PPG\", xlabel=\"Time (s)\", ylabel=\"Amplitude\")\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7a141d44",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-18T07:15:20.440121Z",
     "iopub.status.busy": "2026-09-18T07:15:20.439606Z",
     "iopub.status.idle": "2026-09-18T07:15:20.511581Z",
     "shell.execute_reply": "2026-09-18T07:15:20.510059Z"
    }
   },
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(10, 2.2))\n",
    "colors = [\"#4aa8d8\" if i % 2 == 0 else \"#70b77e\" for i in range(6)]\n",
    "for i, color in enumerate(colors):\n",
    "    ax.barh(0, 1, left=i, color=color, edgecolor=\"white\", height=0.55)\n",
    "    ax.text(i + 0.5, 0, f\"W{i+1}\", ha=\"center\", va=\"center\", color=\"white\", weight=\"bold\")\n",
    "ax.annotate(\"local path (Δt)\", xy=(0.5, 0.38), xytext=(0.5, 0.78), ha=\"center\",\n",
    "            arrowprops={\"arrowstyle\": \"->\", \"color\": \"#247ba0\"}, color=\"#247ba0\")\n",
    "ax.annotate(\"temporal path (T)\", xy=(3.0, -0.38), xytext=(3.0, -0.78), ha=\"center\",\n",
    "            arrowprops={\"arrowstyle\": \"-[,widthB=4.7\", \"color\": \"#2e8b57\"}, color=\"#2e8b57\")\n",
    "ax.set(xlim=(0, 6), ylim=(-1, 1), title=\"T divided into N local windows of duration Δt\")\n",
    "ax.axis(\"off\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8db8cdee",
   "metadata": {},
   "source": [
